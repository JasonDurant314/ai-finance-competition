{
  "$defs": {
    "AssertionStatus": {
      "enum": [
        "pass",
        "fail",
        "skipped"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "经营假设 —— 每个假设必须能指向事实或标注为主观判断。",
      "properties": {
        "assumption_id": {
          "title": "Assumption Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array"
        },
        "is_judgment": {
          "default": false,
          "description": "True 表示主观判断，必须在报告中标注为『观点』",
          "title": "Is Judgment",
          "type": "boolean"
        },
        "basis": {
          "description": "依据说明，写入报告假设表",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        }
      },
      "required": [
        "assumption_id",
        "name",
        "value",
        "unit",
        "basis"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "CompsPeer": {
