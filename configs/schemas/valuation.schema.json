    "value_range_mid": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Value Range Mid"
    },
    "weighting_note": {
      "description": "DCF 与相对估值的加权方式及理由",
      "title": "Weighting Note",
      "type": "string"
    },
    "risk_factors": {
      "items": {
        "type": "string"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "applicability": {
      "default": "",
      "description": "适用范围声明",
      "title": "Applicability",
      "type": "string"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/ValuationAssertion"
      },
      "title": "Assertions",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "entity",
    "as_of",
