  "additionalProperties": false,
  "description": "一次 R4 运行的完整产物 —— runs/<id>/valuation/valuation.json。",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "entity": {
      "title": "Entity",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "built_at": {
      "description": "构建时间。复现时传入 run 的 started_at 以保证产物哈希一致。",
      "format": "date-time",
      "title": "Built At",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "dcf": {
      "$ref": "#/$defs/DCFResult"
    },
    "comps": {
      "$ref": "#/$defs/CompsResult"
    },
    "sensitivity": {
      "$ref": "#/$defs/SensitivityResult"
    },
    "comps_provenance": {
      "additionalProperties": true,
      "description": "可比公司数据的**来源与时点**：快照路径、行情日期、接口来源、倍数算式。放进产物契约是刻意的 —— 读者据此判断「这个倍数区间是从哪来的」，而不必相信报告里的转述。",
      "title": "Comps Provenance",
      "type": "object"
    },
    "value_range_low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Value Range Low"
    },
    "value_range_high": {
